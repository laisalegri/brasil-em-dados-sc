	/// POP3: laranja na região escolhida, azul nas demais.
	measure 'POP3 Cor da região' = IF ( SELECTEDVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria] ) = [Região selecionada (código)], "#eb6834", "#2a78d6" )
		displayFolder: 2 População
