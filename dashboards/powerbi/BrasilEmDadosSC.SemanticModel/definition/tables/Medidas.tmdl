	/// POP4: base_estimativa do ano da linha (tabela de dados).
	measure 'POP4 Base da estimativa' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[base_estimativa] ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada" )
