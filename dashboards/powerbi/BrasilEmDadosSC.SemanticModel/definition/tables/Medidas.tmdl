	measure 'POP4 Estimativa – Base desde 2018 (revisão)' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", 'gold agregado_regiao_ano'[base_estimativa] = "desde_2018" )
