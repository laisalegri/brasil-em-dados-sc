	/// POP3: (Censo 2022 − Censo 2010) ÷ Censo 2010 do território, entre totais prontos da GOLD.
	measure 'POP3 Variação entre os Censos (%)' = VAR _ini = [POP3 Censo 2010 (território)] VAR _fim = [POP3 Censo 2022 (território)] RETURN IF ( NOT ISBLANK ( _ini ) && NOT ISBLANK ( _fim ), ( _fim - _ini ) / _ini * 100 )
