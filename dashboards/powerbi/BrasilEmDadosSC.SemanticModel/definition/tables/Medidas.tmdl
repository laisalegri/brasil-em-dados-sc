/// Tabela só para guardar as medidas explícitas do relatório (docs/dashboards.md, seções 4 e 6).
table Medidas
	lineageTag: f4652040-ab22-47d1-8dde-52b996e62e15

	/// Ano do filtro global (padrão 2023).
	measure 'Ano selecionado' = SELECTEDVALUE ( Anos[Ano], 2023 )
		formatString: 0
		displayFolder: 0 Filtros
		lineageTag: 5934fca2-e4f0-434c-8e6d-1d869cae1dd7

	/// Ano do seletor local de Censo (2010 ou 2022; padrão 2022).
	measure 'Ano Censo selecionado' = SELECTEDVALUE ( 'Ano Censo'[Ano Censo], 2022 )
		formatString: 0
		displayFolder: 0 Filtros
		lineageTag: b5130c33-024c-4553-b06c-6c0016cc533a

	/// Código da região intermediária escolhida; em branco = Santa Catarina (todas).
	measure 'Região selecionada (código)' = IF ( ISFILTERED ( 'Filtro territorio'[Região intermediária] ), SELECTEDVALUE ( 'Filtro territorio'[cod_regiao_intermediaria] ) )
		displayFolder: 0 Filtros
		lineageTag: 1ab055fe-f367-4762-bd50-a932c61e4948

	/// Nome da região intermediária escolhida; em branco = Santa Catarina (todas).
	measure 'Região selecionada (nome)' = IF ( ISFILTERED ( 'Filtro territorio'[Região intermediária] ), SELECTEDVALUE ( 'Filtro territorio'[Região intermediária] ) )
		displayFolder: 0 Filtros
		lineageTag: ffd52509-f2d1-4068-8f16-6d3429bd5a79

	/// 'Santa Catarina' ou 'região de X', para títulos.
	measure 'Território (rótulo)' = VAR _nome = [Região selecionada (nome)] RETURN IF ( ISBLANK ( _nome ), "Santa Catarina", "região de " & _nome )
		displayFolder: 0 Filtros
		lineageTag: 755f6f2f-128e-4c62-af1c-15863cafb20b

	/// Código IBGE (7 dígitos) do município escolhido no filtro global.
	measure 'Município selecionado (código)' = IF ( ISFILTERED ( 'Filtro territorio'[Município] ), SELECTEDVALUE ( 'Filtro territorio'[cod_municipio] ) )
		displayFolder: 0 Filtros
		lineageTag: f688c6a1-f422-419e-8bb5-051d10a9d626

	/// Nome do município escolhido no filtro global (só para exibição; a chave é o código).
	measure 'Município selecionado (nome)' = IF ( ISFILTERED ( 'Filtro territorio'[Município] ), SELECTEDVALUE ( 'Filtro territorio'[Município] ) )
		displayFolder: 0 Filtros
		lineageTag: 1fafbec2-a538-4172-8c5d-7e5be9a8b4d3

	/// 1 se o município da linha (gold dim_municipio) está na região escolhida (ou se a região é SC); em branco fora do recorte.
	measure 'Município no recorte' = VAR _r = [Região selecionada (código)] VAR _cod = SELECTEDVALUE ( 'gold dim_municipio'[cod_municipio] ) RETURN IF ( NOT ISBLANK ( _cod ) && ( ISBLANK ( _r ) || SELECTEDVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria] ) = _r ), 1 )
		formatString: 0
		displayFolder: 0 Filtros
		lineageTag: 0324cef3-3bef-4d85-8485-abc41e4cc95d

	/// Cor para formatação condicional: laranja no município escolhido, azul nos demais (paleta do Streamlit).
	measure 'Cor destaque município' = IF ( SELECTEDVALUE ( 'gold dim_municipio'[cod_municipio] ) = [Município selecionado (código)], "#eb6834", "#2a78d6" )
		displayFolder: 0 Filtros
		lineageTag: 0770c8a6-0a66-4f0f-b934-cbbcb42c6ecc

	/// Rodapé de cada página (C9).
	measure Rodapé = "Fonte: IBGE (SIDRA e API de Pesquisas), elaboração própria."
		displayFolder: 0 Filtros
		lineageTag: bab9bf6b-0d0f-4513-aa82-fa31bfd47fcc

	/// R01: agregado_regiao_ano, estado, pop_censo, 2022 (C1).
	measure 'R01 População SC Censo 2022' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = 2022 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 9d787322-a4d8-4c58-ac85-4419c5daad52

	/// R02: agregado_regiao_ano, estado, pop_censo, 2010 (C1).
	measure 'R02 População SC Censo 2010' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = 2010 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: c3f5c804-124e-4243-a7c5-1c7acd08c1b3

	/// R02: municípios somados no total de SC do Censo 2010.
	measure 'R02 Municípios somados Censo 2010' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[municipios_somados] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = 2010 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: f02fa451-2d9b-4a4c-a7cb-d1c20314b7fd

	/// R03: PIB nominal (valores correntes) de SC em 2023, de agregado_regiao_ano (C1, regra 3).
	measure 'R03 PIB nominal SC 2023' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pib_corrente", 'gold agregado_regiao_ano'[ano] = 2023 )
		formatString: "R$" #,0.00
		displayFolder: R Referências
		lineageTag: f9187d8b-426c-4013-89d2-28846046bc29

	/// R04: PIB nominal (valores correntes) de SC em 2010, de agregado_regiao_ano (C1, regra 3).
	measure 'R04 PIB nominal SC 2010' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pib_corrente", 'gold agregado_regiao_ano'[ano] = 2010 )
		formatString: "R$" #,0.00
		displayFolder: R Referências
		lineageTag: 02754c2e-813d-4108-b012-be45a2cd8ddd

	/// R05: estimativa de SC em 2012, sem 4212650 e 4220000 (regra 13).
	measure 'R05 Estimativa SC 2012' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", 'gold agregado_regiao_ano'[ano] = 2012 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 347fcac2-6ddf-48c1-a316-3aeadfd0126d

	/// R05: municípios somados na estimativa de SC 2012.
	measure 'R05 Municípios somados 2012' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[municipios_somados] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", 'gold agregado_regiao_ano'[ano] = 2012 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: e766cfcd-ca66-42f3-9620-44534b02be85

	/// R05: municípios excluídos da estimativa de SC 2012 (regra 13).
	measure 'R05 Municípios excluídos 2012' = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[municipios_excluidos] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", 'gold agregado_regiao_ano'[ano] = 2012 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 30ef69dc-05ec-4a9c-abdf-632194ea4541

	/// R06: os 3 maiores municípios no Censo 2022, com população e participação (participacao_estadual).
	measure 'R06 3 maiores em população Censo 2022' = VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = 2022, NOT ISBLANK ( 'gold participacao_estadual'[valor] ) ) VAR _top = TOPN ( 3, _t, 'gold participacao_estadual'[valor], DESC ) RETURN CONCATENATEX ( _top, 'gold participacao_estadual'[nome_municipio] & " " & FORMAT ( 'gold participacao_estadual'[valor], "#,0" ) & " (" & FORMAT ( 'gold participacao_estadual'[participacao_percentual], "0.0000" ) & "%)", "; ", 'gold participacao_estadual'[valor], DESC )
		displayFolder: R Referências
		lineageTag: ec7299b3-dd7f-41e9-8b18-5006ee86ff74

	/// R07: os 3 maiores municípios em PIB nominal 2023, com valor e participação (participacao_estadual).
	measure 'R07 3 maiores em PIB nominal 2023' = VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = 2023, NOT ISBLANK ( 'gold participacao_estadual'[valor] ) ) VAR _top = TOPN ( 3, _t, 'gold participacao_estadual'[valor], DESC ) RETURN CONCATENATEX ( _top, 'gold participacao_estadual'[nome_municipio] & " R$ " & FORMAT ( 'gold participacao_estadual'[valor], "#,0.00" ) & " (" & FORMAT ( 'gold participacao_estadual'[participacao_percentual], "0.0000" ) & "%)", "; ", 'gold participacao_estadual'[valor], DESC )
		displayFolder: R Referências
		lineageTag: 19a05857-4e31-4a51-aac7-0ae0f79ef169

	/// R08: Censo 2010 de Florianópolis (4205407).
	measure 'R08 Florianópolis Censo 2010' = CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[pop_censo_2010] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = "4205407" )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: e5100523-1c02-42c4-8fc1-6c84c8e47561

	/// R08: Censo 2022 de Florianópolis (4205407).
	measure 'R08 Florianópolis Censo 2022' = CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[pop_censo_2022] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = "4205407" )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 043a3d9f-1741-4215-bef7-7214410c5e15

	/// R08: variação percentual entre os Censos 2010 e 2022 de Florianópolis.
	measure 'R08 Florianópolis variação entre os Censos' = CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[variacao_percentual] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = "4205407" )
		formatString: +0.00"%";−0.00"%";0.00"%"
		displayFolder: R Referências
		lineageTag: d17c06f0-c138-4c8f-a891-a9f80afbca47

	/// R09: participação de Itajaí (4208203) no PIB nominal de SC em 2010.
	measure 'R09 Itajaí participação no PIB 2010' = CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), REMOVEFILTERS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[cod_municipio] = "4208203", 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = 2010 )
		formatString: 0.0000"%"
		displayFolder: R Referências
		lineageTag: 2538b076-fac6-4a4b-bc22-8bd90b766ded

	/// R09: participação de Itajaí (4208203) no PIB nominal de SC em 2023.
	measure 'R09 Itajaí participação no PIB 2023' = CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), REMOVEFILTERS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[cod_municipio] = "4208203", 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = 2023 )
		formatString: 0.0000"%"
		displayFolder: R Referências
		lineageTag: 5a4a4910-1709-4e6a-bc45-ca94abb08a37

	/// R10: municípios com variação percentual entre os Censos (COUNT ignora brancos).
	measure 'R10 Municípios comparáveis entre os Censos' = CALCULATE ( COUNT ( 'gold variacao_populacao_censo'[variacao_percentual] ), REMOVEFILTERS ( 'gold dim_municipio' ), REMOVEFILTERS ( 'gold variacao_populacao_censo' ) )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 4486d1d2-936f-4216-9ad6-e297e09e2a0c

	/// R10: municípios com variacao_absoluta < 0 entre os Censos.
	measure 'R10 Municípios que perderam população' = CALCULATE ( COUNTROWS ( 'gold variacao_populacao_censo' ), REMOVEFILTERS ( 'gold dim_municipio' ), REMOVEFILTERS ( 'gold variacao_populacao_censo' ), 'gold variacao_populacao_censo'[variacao_absoluta] < 0 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: a473c4a0-f132-4b52-a567-1be37d537d62

	/// R11: município com o maior PIB per capita publicado em 2023 (sem agregação; regra 4).
	measure 'R11 Maior PIB per capita 2023 (município)' = VAR _t = CALCULATETABLE ( 'gold painel_municipio_ano', REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[ano] = 2023, NOT ISBLANK ( 'gold painel_municipio_ano'[pib_per_capita_reais] ) ) RETURN CONCATENATEX ( TOPN ( 1, _t, 'gold painel_municipio_ano'[pib_per_capita_reais], DESC ), 'gold painel_municipio_ano'[nome_municipio], ", " )
		displayFolder: R Referências
		lineageTag: 4c11447d-ed0e-4afb-adb4-ed2cba5aff74

	/// R11: maior PIB per capita publicado em 2023, valor de um município (não é per capita agregado; regra 4).
	measure 'R11 Maior PIB per capita 2023 (valor)' = CALCULATE ( MAX ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[ano] = 2023 )
		formatString: "R$" #,0.00
		displayFolder: R Referências
		lineageTag: e54e99d2-80e6-4a57-b0cc-5fb826a6f7f2

	/// R12: mediana entre os municípios do PIB per capita publicado em 2023. Não é o per capita de SC (regra 4).
	measure 'R12 PIB per capita 2023: mediana entre os municípios' = CALCULATE ( MEDIAN ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[ano] = 2023 )
		formatString: "R$" #,0.00
		displayFolder: R Referências
		lineageTag: 8a6d9517-246e-4192-aa36-f6d5f36a6d42

	/// R12: municípios com PIB per capita publicado em 2023 (base da mediana).
	measure 'R12 Municípios com PIB per capita 2023' = CALCULATE ( COUNT ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[ano] = 2023 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 65cbd4ef-5f05-4f6e-9965-bf6d41d8a155

	/// R13: variações anuais do PIB nominal com |variação| > 50% (alerta A1).
	measure 'R13 Saltos de PIB nominal acima de 50% (variações)' = CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) && ABS ( 'gold variacao_anual'[variacao_percentual] ) > 50 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: e629afd5-2822-419c-814f-00fdaece215d

	/// R13: municípios com ao menos uma variação anual do PIB nominal acima de 50% em módulo (alerta A1).
	measure 'R13 Saltos de PIB nominal acima de 50% (municípios)' = CALCULATE ( DISTINCTCOUNT ( 'gold variacao_anual'[cod_municipio] ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) && ABS ( 'gold variacao_anual'[variacao_percentual] ) > 50 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 48c79172-fe05-4c5e-84c4-4aa5ea1fec2b

	/// R14: pares municipais da variação da estimativa 2012→2013 (quebra de série; regra 12).
	measure 'R14 Estimativa 2012→2013 pares' = CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: f5ab414b-e267-4bd5-899d-7b2d71377906

	/// R14: pares 2012→2013 com variação calculada (esperado 0; regra 12). É uma contagem: zero linhas = 0 (não é ausência de valor).
	measure 'R14 Estimativa 2012→2013 com variação' = CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013, NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) ) + 0
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 315edd9a-9f19-449f-930b-c207c28d79f9

	/// R14: pares 2012→2013 com comparavel = verdadeiro (esperado 0; regra 12).
	measure 'R14 Estimativa 2012→2013 comparáveis' = CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013, 'gold variacao_anual'[comparavel] = TRUE () ) + 0
		formatString: #,0
		displayFolder: R Referências
		lineageTag: fe6e1833-0af5-48f9-bb3d-14fcfa7e2ac8

	/// R15: pares municipais da variação da estimativa 2017→2018 (revisão da projeção; regra 12).
	measure 'R15 Estimativa 2017→2018 pares' = CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2018 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: bd541ad5-28ce-4ac7-9ec9-1ace76e32027

	/// R15: pares 2017→2018 com variação calculada (esperado 295; regra 12).
	measure 'R15 Estimativa 2017→2018 com variação' = CALCULATE ( COUNT ( 'gold variacao_anual'[variacao_percentual] ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2018 )
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 7ece02ef-10db-4e90-8848-ac46bd7dc0e9

	/// R15: pares 2017→2018 com comparavel = verdadeiro (esperado 0; regra 12).
	measure 'R15 Estimativa 2017→2018 comparáveis' = CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2018, 'gold variacao_anual'[comparavel] = TRUE () ) + 0
		formatString: #,0
		displayFolder: R Referências
		lineageTag: 7e4d175a-3597-4613-9b7a-842c1c6a3b4e

	/// Regra 3 (textos.py AVISO_PIB_NOMINAL).
	measure 'Aviso PIB nominal' = "PIB nominal, a preços correntes: a variação entre anos inclui inflação e não é crescimento real (regra 3)."
		displayFolder: Avisos
		lineageTag: 4569a6f3-a5bd-4f7c-80a2-2e2b15d4de5c

	/// Limitações, seção 5 (AVISO_REVISAO_PIB).
	measure 'Aviso revisão do PIB' = "2021–2023 foram revisados pelo IBGE em 19/12/2025; 2022–2023 ainda estão sujeitos a revisão (limitações, seção 5)."
		displayFolder: Avisos
		lineageTag: 9355fad9-d62d-4d29-94a1-dc3facaa8a4d

	/// Limitações, seção 6 (AVISO_DISTRIBUICAO).
	measure 'Aviso distribuição do PIB' = "O PIB municipal é uma distribuição do PIB estadual feita pelo IBGE por indicadores de atividade, e não uma medição direta (limitações, seção 6)."
		displayFolder: Avisos
		lineageTag: 4b92d5a6-9096-4984-95aa-3e1f7a944013

	/// C7, regra 4 (AVISO_PER_CAPITA).
	measure 'Aviso PIB per capita' = "PIB per capita publicado pelo IBGE; não é renda (regra 4)."
		displayFolder: Avisos
		lineageTag: 494d0fae-deac-408f-b487-fc24328e8e39

	/// Limitações, seção 9 (AVISO_DENOMINADOR).
	measure 'Aviso denominador do per capita' = "O denominador do per capita muda conforme o ano: estimativa até 2021, 1ª apuração do Censo em 2022 (limitações, seção 9)."
		displayFolder: Avisos
		lineageTag: ded1faea-ec4d-43ac-a494-2ed1a6395c80

	/// Alerta A1 (AVISO_A1).
	measure 'Aviso A1' = "Alerta A1: em municípios pequenos, a entrada ou a saída de um estabelecimento pode multiplicar o PIB de um ano para outro; a causa de cada caso é NÃO CONFIRMADA (limitações, seção 6)."
		displayFolder: Avisos
		lineageTag: 84edf0cf-96dd-4077-bde7-00dcff963de5

	/// ECO2 e PER5 (AVISO_PARTICIPACAO).
	measure 'Aviso participação' = "A participação é uma razão entre valores do mesmo ano e não depende da inflação geral, mas reflete diferenças de preços entre atividades."
		displayFolder: Avisos
		lineageTag: b059a67f-8c12-4595-ad08-2fdc1a49742c

	/// VG4, regra 4 (AVISO_SEM_PER_CAPITA_REGIONAL).
	measure 'Aviso sem per capita regional' = "Comparação entre participações; não é PIB per capita regional (regra 4)."
		displayFolder: Avisos
		lineageTag: e81031c8-d0c7-4978-b89f-5905fe2469cc

	/// C8, regra 12 (AVISO_QUEBRAS).
	measure 'Aviso quebras da estimativa' = "Estimativa com três bases (regra 12): de 2012 para 2013 há quebra de série (nova projeção por UF) e a variação não é calculada; de 2017 para 2018 há revisão da projeção, e o IBGE declara comparáveis só 2013–2017. Linhas de bases diferentes não se ligam."
		displayFolder: Avisos
		lineageTag: 3d9deaf7-b91f-48ee-998a-b1fd46f8db08

	/// Regra 13 (AVISO_DUPLA_CONTAGEM).
	measure 'Aviso dupla contagem 2012' = "Em 2012, o total exclui Pescaria Brava (4212650) e Balneário Rincão (4220000), em dupla contagem com o município de origem (regra 13)."
		displayFolder: Avisos
		lineageTag: 765b0558-8c81-4f2f-b303-24a632e1ef3c

	/// Regra 2 (AVISO_CENSO_OFICIAL).
	measure 'Aviso Censo oficial' = "A variação oficial de população é Censo 2010 × Censo 2022; a estimativa não substitui os Censos (regra 2)."
		displayFolder: Avisos
		lineageTag: 3a882542-f132-4fb5-941b-f7dc20e432c2

	/// Limitações, seção 8 (AVISO_APURACOES).
	measure 'Aviso apurações do Censo 2022' = "O Censo 2022 tem duas apurações; a diferença entre elas não foi confirmada (limitações, seção 8)."
		displayFolder: Avisos
		lineageTag: 2e78c674-0e1f-45e8-be17-4c75da5cb681

	/// POP2 (AVISO_LAGUNA).
	measure 'Aviso Laguna' = "Laguna: a queda pode vir do desmembramento de Pescaria Brava (NÃO CONFIRMADO; limitações, seção 10)."
		displayFolder: Avisos
		lineageTag: c222e866-8c9d-43f4-a7ef-8e2e786ad6b3

	/// POP3 (AVISO_CRICIUMA).
	measure 'Aviso Criciúma' = "Região de Criciúma: inclui os 2 municípios instalados em 2013; o território é o mesmo em 2010 e 2022 só se a população deles estava em Laguna e Içara em 2010 (NÃO CONFIRMADO; limitações, seção 10)."
		displayFolder: Avisos
		lineageTag: a6ab0ba7-c651-48af-a2e5-e95ca85f7c8c

	/// Regras 6 e 10 (AVISO_NAO_INSTALADO).
	measure 'Aviso não instalado' = "Município instalado em 2013: sem dado antes disso (regras 6 e 10)."
		displayFolder: Avisos
		lineageTag: 00ca6597-d197-4629-b2da-b58912b9dfcb

	/// Regra 12 (AVISO_REVISAO_2018).
	measure 'Aviso revisão 2018' = "2017→2018: revisão da projeção; a variação é calculada, mas o IBGE declara comparáveis só 2013–2017 (regra 12)."
		displayFolder: Avisos
		lineageTag: 4dd0d626-b689-41b0-9f3c-48fcd24f9ea0

	/// 'de Santa Catarina' ou 'da região de X' (textos.de_territorio).
	measure 'Território (com preposição)' = VAR _nome = [Região selecionada (nome)] RETURN IF ( ISBLANK ( _nome ), "de Santa Catarina", "da região de " & _nome )
		displayFolder: 0 Filtros
		lineageTag: 34118e4a-63f5-45ca-8c39-210d1027b199

	/// VG1a: Censo 2022 do estado ou da região escolhida, lido pronto de agregado_regiao_ano (C1). Não responde ao filtro de ano.
	measure 'VG1a População (Censo 2022)' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = 2022 )
		formatString: #,0
		displayFolder: 1 Visão geral
		lineageTag: e3dfd0b8-d132-45e6-9543-ffb39d9717eb

	/// VG1b: PIB nominal (valores correntes) do estado ou da região no ano do filtro, de agregado_regiao_ano (C1, regra 3).
	measure 'VG1b PIB nominal no ano' = VAR _r = [Região selecionada (código)] VAR _a = [Ano selecionado] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pib_corrente", 'gold agregado_regiao_ano'[ano] = _a )
		formatString: "R$" #,0.00
		displayFolder: 1 Visão geral
		lineageTag: e95ecdbc-0480-49a7-9244-242868883bcc

	/// VG1b: rótulo do cartão, 'PIB nominal AAAA'.
	measure 'VG1b Rótulo' = "PIB nominal " & [Ano selecionado]
		displayFolder: 1 Visão geral
		lineageTag: 71da292d-4a01-4393-950f-a37d7e3d0f91

	/// VG1b: legenda com o valor exato, como no Streamlit.
	measure 'VG1b Valor exato (texto)' = VAR _v = [VG1b PIB nominal no ano] RETURN "PIB nominal " & [Ano selecionado] & ", valor exato: " & IF ( ISBLANK ( _v ), "sem dado", "R$ " & FORMAT ( _v, "#,0.00" ) ) & "."
		displayFolder: 1 Visão geral
		lineageTag: 1c101372-401f-4519-b932-8d36a318483a

	/// VG1c: contagem de municípios em gold.dim_municipio no estado ou na região escolhida.
	measure 'VG1c Municípios' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold dim_municipio' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ) )
		formatString: #,0
		displayFolder: 1 Visão geral
		lineageTag: 8f936790-bfdd-4052-8080-348881592b52

	/// VG2: PIB nominal por ano (eixo 'gold agregado_regiao_ano'[ano]), estado ou região, de agregado_regiao_ano (C1, regra 3).
	measure 'VG2 PIB nominal (valores correntes)' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pib_corrente" )
		formatString: "R$" #,0.00
		displayFolder: 1 Visão geral
		lineageTag: 56182bdb-b1e0-45b6-87e1-2cdd99f152df

	/// VG2: variação nominal (%) sobre o ano anterior, entre dois totais prontos da GOLD; não é crescimento real (regra 3). Em branco em 2010.
	measure 'VG2 Variação nominal sobre o ano anterior' = VAR _ano = SELECTEDVALUE ( 'gold agregado_regiao_ano'[ano] ) VAR _atual = [VG2 PIB nominal (valores correntes)] VAR _ant = CALCULATE ( [VG2 PIB nominal (valores correntes)], 'gold agregado_regiao_ano'[ano] = _ano - 1 ) RETURN IF ( NOT ISBLANK ( _atual ) && NOT ISBLANK ( _ant ), ( _atual - _ant ) / _ant * 100 )
		formatString: +0.00"%";−0.00"%";0.00"%"
		displayFolder: 1 Visão geral
		lineageTag: acb90a85-9da5-4045-af0f-678cb4a76fa7

	/// VG2: laranja no ano do filtro, azul nos demais (formatação condicional).
	measure 'VG2 Cor do ano' = IF ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[ano] ) = [Ano selecionado], "#eb6834", "#2a78d6" )
		displayFolder: 1 Visão geral
		lineageTag: 51d31ab4-0fa7-4f6a-8e03-6ac349985675

	/// VG2: título com o achado (textos.titulo_serie_pib). Abreviação só pelo formato (C3).
	measure 'VG2 Título' = VAR _ini = CALCULATE ( [VG2 PIB nominal (valores correntes)], 'gold agregado_regiao_ano'[ano] = 2010 ) VAR _fim = CALCULATE ( [VG2 PIB nominal (valores correntes)], 'gold agregado_regiao_ano'[ano] = 2023 ) RETURN "PIB nominal " & [Território (com preposição)] & ": de R$ " & FORMAT ( _ini, "0,,,.0" ) & " bi (2010) para R$ " & FORMAT ( _fim, "0,,,.0" ) & " bi (2023), em valores correntes"
		displayFolder: 1 Visão geral
		lineageTag: 98cd683d-9ede-4dd1-abac-750d211b2241

	/// VG3a: soma de participacao_percentual dos 10 maiores no Censo 2022 (sempre o estado). Soma participações prontas da GOLD; não monta total.
	measure 'VG3a Participação dos 10 maiores (Censo 2022)' = VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = 2022, NOT ISBLANK ( 'gold participacao_estadual'[participacao_percentual] ) ) RETURN SUMX ( TOPN ( 10, _t, 'gold participacao_estadual'[participacao_percentual], DESC ), 'gold participacao_estadual'[participacao_percentual] )
		formatString: 0.0"%"
		displayFolder: 1 Visão geral
		lineageTag: f41a57fb-e6ae-4064-952e-2d5ed9918081

	/// VG3b: soma de participacao_percentual dos 10 maiores em PIB nominal no ano do filtro (sempre o estado).
	measure 'VG3b Participação dos 10 maiores (PIB nominal no ano)' = VAR _a = [Ano selecionado] VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a, NOT ISBLANK ( 'gold participacao_estadual'[participacao_percentual] ) ) RETURN SUMX ( TOPN ( 10, _t, 'gold participacao_estadual'[participacao_percentual], DESC ), 'gold participacao_estadual'[participacao_percentual] )
		formatString: 0.0"%"
		displayFolder: 1 Visão geral
		lineageTag: a77b158a-872d-4611-98be-5b1860178168

	/// VG3a: menor número de municípios, do maior para o menor, cuja participação acumulada chega a 50% (analise.calculos.quantos_somam).
	measure 'VG3a Municípios que somam metade (Censo 2022)' = VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = 2022, NOT ISBLANK ( 'gold participacao_estadual'[participacao_percentual] ) ) VAR _ac = ADDCOLUMNS ( _t, "@acum", VAR _p = 'gold participacao_estadual'[participacao_percentual] RETURN SUMX ( FILTER ( _t, 'gold participacao_estadual'[participacao_percentual] >= _p ), 'gold participacao_estadual'[participacao_percentual] ) ) RETURN COUNTROWS ( FILTER ( _ac, [@acum] < 50 ) ) + 1
		formatString: #,0
		displayFolder: 1 Visão geral
		lineageTag: 7cd41cee-fd15-45cd-bd1e-d99c8e77ad03

	/// VG3b: menor número de municípios cuja participação acumulada no PIB nominal do ano chega a 50%.
	measure 'VG3b Municípios que somam metade (PIB nominal no ano)' = VAR _a = [Ano selecionado] VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a, NOT ISBLANK ( 'gold participacao_estadual'[participacao_percentual] ) ) VAR _ac = ADDCOLUMNS ( _t, "@acum", VAR _p = 'gold participacao_estadual'[participacao_percentual] RETURN SUMX ( FILTER ( _t, 'gold participacao_estadual'[participacao_percentual] >= _p ), 'gold participacao_estadual'[participacao_percentual] ) ) RETURN COUNTROWS ( FILTER ( _ac, [@acum] < 50 ) ) + 1
		formatString: #,0
		displayFolder: 1 Visão geral
		lineageTag: 2c935a5e-3e0e-416a-83a0-1f28dda53306

	/// VG3: título (textos.titulo_concentracao).
	measure 'VG3 Título' = "Os 10 maiores municípios somam " & FORMAT ( [VG3a Participação dos 10 maiores (Censo 2022)], "0.00" ) & "% da população (Censo 2022) e " & FORMAT ( [VG3b Participação dos 10 maiores (PIB nominal no ano)], "0.00" ) & "% do PIB nominal de " & [Ano selecionado]
		displayFolder: 1 Visão geral
		lineageTag: 1f12c574-9262-4180-a9b3-c91371b46298

	/// VG3: texto auxiliar com o menor N que soma metade.
	measure 'VG3 Texto metade' = "Metade da população (Censo 2022) está em " & [VG3a Municípios que somam metade (Censo 2022)] & " municípios; metade do PIB nominal de " & [Ano selecionado] & ", em " & [VG3b Municípios que somam metade (PIB nominal no ano)] & ". Concentração medida sempre no estado inteiro."
		displayFolder: 1 Visão geral
		lineageTag: 8cfa067a-0b2b-4cfc-a665-57e0b0b3a42b

	/// VG4: valor da região ÷ valor do estado, pib_corrente, ano do seletor local (2010 ou 2022). Duas linhas de agregado_regiao_ano (C2). Eixo: 'gold dim_municipio'[nome_regiao_intermediaria].
	measure 'VG4 Participação no PIB nominal (%)' = VAR _a = [Ano Censo selecionado] VAR _reg = SELECTEDVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria] ) VAR _v = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "regiao_intermediaria", 'gold agregado_regiao_ano'[cod_regiao] = _reg, 'gold agregado_regiao_ano'[codigo_indicador] = "pib_corrente", 'gold agregado_regiao_ano'[ano] = _a ) VAR _t = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pib_corrente", 'gold agregado_regiao_ano'[ano] = _a ) RETURN IF ( NOT ISBLANK ( _reg ), DIVIDE ( _v, _t ) * 100 )
		formatString: 0.00"%"
		displayFolder: 1 Visão geral
		lineageTag: 037618cb-937e-4607-a289-4ea4814e4296

	/// VG4: valor da região ÷ valor do estado, pop_censo, ano do seletor local (2010 ou 2022) (C2).
	measure 'VG4 Participação na população Censo (%)' = VAR _a = [Ano Censo selecionado] VAR _reg = SELECTEDVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria] ) VAR _v = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "regiao_intermediaria", 'gold agregado_regiao_ano'[cod_regiao] = _reg, 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = _a ) VAR _t = CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = _a ) RETURN IF ( NOT ISBLANK ( _reg ), DIVIDE ( _v, _t ) * 100 )
		formatString: 0.00"%"
		displayFolder: 1 Visão geral
		lineageTag: d2a9f231-3da2-4216-a486-d193614ad560

	/// VG4: participação no PIB menos participação na população, em pontos percentuais. Não é PIB per capita regional (regra 4).
	measure 'VG4 Diferença (p.p.)' = VAR _pib = [VG4 Participação no PIB nominal (%)] VAR _pop = [VG4 Participação na população Censo (%)] RETURN IF ( NOT ISBLANK ( _pib ) && NOT ISBLANK ( _pop ), _pib - _pop )
		formatString: +0.00" p.p.";−0.00" p.p.";0.00" p.p."
		displayFolder: 1 Visão geral
		lineageTag: d23ab287-d024-4381-a214-fa85c5a5d0c0

	/// VG4: título (textos.titulo_regioes_pib_pop).
	measure 'VG4 Título' = VAR _t = ADDCOLUMNS ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria], 'gold dim_municipio'[nome_regiao_intermediaria] ), "@d", [VG4 Diferença (p.p.)] ) RETURN "Em " & COUNTROWS ( FILTER ( _t, [@d] > 0 ) ) + 0 & " das " & COUNTROWS ( _t ) & " regiões intermediárias, a participação no PIB nominal supera a participação na população (" & [Ano Censo selecionado] & ")"
		displayFolder: 1 Visão geral
		lineageTag: fbeaabb4-813c-44fb-ba63-e6bca134e6cd

	/// POP1: população do Censo (2010 ou 2022, seletor local) do município da linha (eixo 'gold dim_municipio'[nome_municipio]); em branco fora da região escolhida. Sem agregação: no total fica em branco.
	measure 'POP1 População (Censo)' = VAR _a = [Ano Censo selecionado] RETURN IF ( [Município no recorte] = 1, CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[valor] ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = _a ) )
		formatString: #,0
		displayFolder: 2 População
		lineageTag: a3ec4d7a-2238-49d7-ac64-cdadf5c54ac9

	/// POP1: participacao_percentual do município no Censo escolhido (C2).
	measure 'POP1 Participação no estado (%)' = VAR _a = [Ano Censo selecionado] RETURN IF ( [Município no recorte] = 1, CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = _a ) )
		formatString: 0.0000"%"
		displayFolder: 2 População
		lineageTag: 0ef36e11-d1ce-44ec-b96a-81a83da7efe1

	/// POP1: 'não instalado' (regra 6) ou 'sem dado' quando o município não tem Censo no ano escolhido (regra 5).
	measure 'POP1 Situação' = VAR _a = [Ano Censo selecionado] VAR _inst = SELECTEDVALUE ( 'gold dim_municipio'[ano_instalacao] ) RETURN IF ( [Município no recorte] = 1 && ISBLANK ( [POP1 População (Censo)] ), IF ( NOT ISBLANK ( _inst ) && _inst > _a, "não instalado", "sem dado" ) )
		displayFolder: 2 População
		lineageTag: 4caa8365-5996-411b-b208-0c28de43f8aa

	/// POP1: municípios da região sem Censo no ano escolhido, com o aviso de não instalado (regras 6 e 10).
	measure 'POP1 Sem Censo (texto)' = VAR _a = [Ano Censo selecionado] VAR _r = [Região selecionada (código)] VAR _t = FILTER ( CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = _a ), ISBLANK ( 'gold participacao_estadual'[valor] ) ) RETURN IF ( NOT ISEMPTY ( _t ), "Sem Censo " & _a & ": " & CONCATENATEX ( _t, 'gold participacao_estadual'[nome_municipio], ", ", 'gold participacao_estadual'[nome_municipio], ASC ) & ". " & [Aviso não instalado], "" )
		displayFolder: 2 População
		lineageTag: 5f8d6b0f-7e72-491a-ab7f-29cf2639e33f

	/// POP1: título (textos.titulo_lider).
	measure 'POP1 Título' = VAR _a = [Ano Censo selecionado] VAR _r = [Região selecionada (código)] VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = _a, NOT ISBLANK ( 'gold participacao_estadual'[valor] ) ) VAR _top = TOPN ( 1, _t, 'gold participacao_estadual'[valor], DESC ) RETURN MAXX ( _top, 'gold participacao_estadual'[nome_municipio] ) & " lidera a população" & IF ( ISBLANK ( _r ), "", " da região de " & [Região selecionada (nome)] ) & " no Censo " & _a & ", com " & FORMAT ( MAXX ( _top, 'gold participacao_estadual'[participacao_percentual] ), "0.00" ) & "% do estado"
		displayFolder: 2 População
		lineageTag: 218b4929-ed64-43ed-b371-58af88b4564e

	/// POP2: variacao_absoluta entre os Censos 2010 e 2022 do município da linha; em branco fora da região ou sem Censo 2010.
	measure 'POP2 Variação absoluta' = IF ( [Município no recorte] = 1, SELECTEDVALUE ( 'gold variacao_populacao_censo'[variacao_absoluta] ) )
		formatString: +#,0;−#,0;0
		displayFolder: 2 População
		lineageTag: 228ec4cf-2991-4f8a-95e2-cad11c9852ab

	/// POP2: variacao_percentual entre os Censos 2010 e 2022 do município da linha.
	measure 'POP2 Variação percentual' = IF ( [Município no recorte] = 1, SELECTEDVALUE ( 'gold variacao_populacao_censo'[variacao_percentual] ) )
		formatString: +0.00"%";−0.00"%";0.00"%"
		displayFolder: 2 População
		lineageTag: 913a2cce-25e1-4613-ac7f-758dde69b39a

	/// POP2: motivo da view quando não há variação (regra 5).
	measure 'POP2 Motivo' = IF ( [Município no recorte] = 1, SELECTEDVALUE ( 'gold variacao_populacao_censo'[motivo] ) )
		displayFolder: 2 População
		lineageTag: bf77cbf4-7fa7-4470-b51c-781f92e0aa9a

	/// POP2: municípios da região com variação entre os Censos (contagem; zero é zero).
	measure 'POP2 Municípios comparáveis' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNT ( 'gold variacao_populacao_censo'[variacao_percentual] ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ) ) + 0
		formatString: #,0
		displayFolder: 2 População
		lineageTag: a9c1e1f5-3af9-43f5-850d-781ba3539573

	/// POP2: municípios comparáveis da região com variacao_absoluta > 0 (contagem).
	measure 'POP2 Cresceram' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_populacao_censo' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), NOT ISBLANK ( 'gold variacao_populacao_censo'[variacao_percentual] ), 'gold variacao_populacao_censo'[variacao_absoluta] > 0 ) + 0
		formatString: #,0
		displayFolder: 2 População
		lineageTag: e009d10f-cb1c-4482-b22d-719409fef1d5

	/// POP2: municípios comparáveis da região com variacao_absoluta < 0 (contagem).
	measure 'POP2 Perderam população' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_populacao_censo' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), NOT ISBLANK ( 'gold variacao_populacao_censo'[variacao_percentual] ), 'gold variacao_populacao_censo'[variacao_absoluta] < 0 ) + 0
		formatString: #,0
		displayFolder: 2 População
		lineageTag: d109a4c6-6954-4d93-ab25-88b64ff8b58f

	/// POP2: mediana entre os municípios da região da variação percentual entre os Censos (MEDIAN ignora brancos).
	measure 'POP2 Variação: mediana entre os municípios' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( MEDIAN ( 'gold variacao_populacao_censo'[variacao_percentual] ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ) )
		formatString: +0.0"%";−0.0"%";0.0"%"
		displayFolder: 2 População
		lineageTag: f5e26f07-c3c6-4f0a-95fc-4db3e7ddccc2

	/// POP2: 1 se o município está entre os 10 maiores ganhos ou as 10 maiores perdas percentuais da região (filtro de visual = 1).
	measure 'POP2 Entre os extremos (percentual)' = VAR _r = [Região selecionada (código)] VAR _v = [POP2 Variação percentual] VAR _u = CALCULATETABLE ( 'gold variacao_populacao_censo', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), NOT ISBLANK ( 'gold variacao_populacao_censo'[variacao_percentual] ) ) RETURN IF ( NOT ISBLANK ( _v ) && ( ( _v > 0 && COUNTROWS ( FILTER ( _u, 'gold variacao_populacao_censo'[variacao_percentual] > _v ) ) < 10 ) || ( _v < 0 && COUNTROWS ( FILTER ( _u, 'gold variacao_populacao_censo'[variacao_percentual] < _v ) ) < 10 ) ), 1 )
		formatString: 0
		displayFolder: 2 População
		lineageTag: eb086a37-b2dc-4204-b773-0a0b42c51817

	/// POP2: 1 se o município está entre os 10 maiores ganhos ou as 10 maiores perdas absolutas da região.
	measure 'POP2 Entre os extremos (absoluta)' = VAR _r = [Região selecionada (código)] VAR _v = [POP2 Variação absoluta] VAR _u = CALCULATETABLE ( 'gold variacao_populacao_censo', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), NOT ISBLANK ( 'gold variacao_populacao_censo'[variacao_absoluta] ) ) RETURN IF ( NOT ISBLANK ( _v ) && ( ( _v > 0 && COUNTROWS ( FILTER ( _u, 'gold variacao_populacao_censo'[variacao_absoluta] > _v ) ) < 10 ) || ( _v < 0 && COUNTROWS ( FILTER ( _u, 'gold variacao_populacao_censo'[variacao_absoluta] < _v ) ) < 10 ) ), 1 )
		formatString: 0
		displayFolder: 2 População
		lineageTag: 359bc319-39de-432e-a5e5-6fcdace16707

	/// POP2: título (textos.titulo_variacao_censo).
	measure 'POP2 Título' = [POP2 Perderam população] & " de " & [POP2 Municípios comparáveis] & " municípios " & [Território (com preposição)] & " perderam população entre os Censos 2010 e 2022"
		displayFolder: 2 População
		lineageTag: c3ba9265-aa0e-4ea0-81b7-cd3b1b16a00f

	/// POP2: municípios da região sem variação, com o motivo da view.
	measure 'POP2 Sem variação (texto)' = VAR _r = [Região selecionada (código)] VAR _t = FILTER ( CALCULATETABLE ( 'gold variacao_populacao_censo', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ) ), NOT ISBLANK ( 'gold variacao_populacao_censo'[motivo] ) ) RETURN IF ( NOT ISEMPTY ( _t ), "Sem variação: " & CONCATENATEX ( _t, 'gold variacao_populacao_censo'[nome_municipio] & " (" & 'gold variacao_populacao_censo'[motivo] & ")", "; ", 'gold variacao_populacao_censo'[nome_municipio], ASC ) & ".", "" )
		displayFolder: 2 População
		lineageTag: 638c870f-0c4e-4ef1-bd5d-c9ed36f88906

	/// POP3: Censo 2010 da região da linha (eixo 'gold dim_municipio'[nome_regiao_intermediaria]) ou do estado no total, de agregado_regiao_ano (C1).
	measure 'POP3 Censo 2010 (território)' = VAR _reg = IF ( HASONEVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria] ), VALUES ( 'gold dim_municipio'[cod_regiao_intermediaria] ) ) RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _reg ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _reg ), "42", _reg ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = 2010 )
		formatString: #,0
		displayFolder: 2 População
		lineageTag: 06652b73-260e-409e-a1af-793eb3e06fad

	/// POP3: Censo 2022 da região da linha ou do estado no total, de agregado_regiao_ano (C1).
	measure 'POP3 Censo 2022 (território)' = VAR _reg = IF ( HASONEVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria] ), VALUES ( 'gold dim_municipio'[cod_regiao_intermediaria] ) ) RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _reg ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _reg ), "42", _reg ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_censo", 'gold agregado_regiao_ano'[ano] = 2022 )
