	/// POP3: título (textos.titulo_regioes_censo).
	measure 'POP3 Título' = VAR _t = ADDCOLUMNS ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria], 'gold dim_municipio'[nome_regiao_intermediaria] ), "@v", [POP3 Variação entre os Censos (%)] ) VAR _max = TOPN ( 1, _t, [@v], DESC ) VAR _min = TOPN ( 1, _t, [@v], ASC ) RETURN "Entre os Censos, a região de " & MAXX ( _max, 'gold dim_municipio'[nome_regiao_intermediaria] ) & " cresceu mais (" & FORMAT ( MAXX ( _max, [@v] ), "+0.0;−0.0" ) & "%) e a de " & MAXX ( _min, 'gold dim_municipio'[nome_regiao_intermediaria] ) & ", menos (" & FORMAT ( MAXX ( _min, [@v] ), "+0.0;−0.0" ) & "%)"
		displayFolder: 2 População
		lineageTag: 1a426546-5fde-4a80-8b90-21d754e281e3

	/// POP4: estimativa do estado ou da região (agregado_regiao_ano), só nos anos da base ate_2012 (eixo 'gold agregado_regiao_ano'[ano]). Série separada por base (C8, regra 12); 2012 sem 4212650 e 4220000 (regra 13).
	measure 'POP4 Estimativa – Base até 2012' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", 'gold agregado_regiao_ano'[base_estimativa] = "ate_2012" )
