	/// POP4: aviso da view no ano da linha (2012: regra 13).
	measure 'POP4 Aviso da linha' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[aviso] ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada" )
