		lineageTag: 1d9d6127-884d-486e-8273-d473f09a4041

	/// POP4: motivo da view para a variação 2012→2013 (proibição 4: a variação não é exibida).
	measure 'POP4 Motivo 2012→2013' = CALCULATE ( CONCATENATEX ( VALUES ( 'gold variacao_anual'[motivo] ), 'gold variacao_anual'[motivo], "; " ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013, NOT ISBLANK ( 'gold variacao_anual'[motivo] ) )
		displayFolder: 2 População
		lineageTag: fa1df8d5-3229-4278-9308-527b6cca7349

	/// POP4: pares municipais da região na variação 2017→2018 da estimativa (regra 12).
	measure 'POP4 Pares 2017→2018' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2018 ) + 0
		formatString: #,0
		displayFolder: 2 População
		lineageTag: 24e8e569-0e0d-4482-ae1d-dde29c5c0aed

	/// POP4: pares 2017→2018 com variação calculada; só exibir com o Aviso revisão 2018 (regra 12).
	measure 'POP4 Com variação 2017→2018' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2018, NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) ) + 0
		formatString: #,0
		displayFolder: 2 População
		lineageTag: 283e1579-781f-427d-bba6-5583db02dfc6

	/// POP4: motivo da view para a variação 2017→2018 (comparavel = falso).
	measure 'POP4 Motivo 2017→2018' = CALCULATE ( CONCATENATEX ( VALUES ( 'gold variacao_anual'[motivo] ), 'gold variacao_anual'[motivo], "; " ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2018, NOT ISBLANK ( 'gold variacao_anual'[motivo] ) )
		displayFolder: 2 População
		lineageTag: c0f098dc-02d8-4f8e-99a2-feb316558d3d

	/// ECO1: PIB nominal (valores correntes) do município da linha no ano do filtro (participacao_estadual); em branco fora da região (regra 3).
	measure 'ECO1 PIB nominal no ano' = VAR _a = [Ano selecionado] RETURN IF ( [Município no recorte] = 1, CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[valor] ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a ) )
		formatString: "R$" #,0.00
		displayFolder: 3 Economia
		lineageTag: a6960f2e-2cc6-4c90-a273-2311da42fdc0

	/// ECO1: participacao_percentual do município no PIB nominal do estado no ano (C2).
	measure 'ECO1 Participação no estado (%)' = VAR _a = [Ano selecionado] RETURN IF ( [Município no recorte] = 1, CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a ) )
		formatString: 0.0000"%"
		displayFolder: 3 Economia
		lineageTag: bcd2f415-8cb1-4904-ba23-57e7131ed4f8

	/// ECO1: título (textos.titulo_lider).
	measure 'ECO1 Título' = VAR _a = [Ano selecionado] VAR _r = [Região selecionada (código)] VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a, NOT ISBLANK ( 'gold participacao_estadual'[valor] ) ) VAR _top = TOPN ( 1, _t, 'gold participacao_estadual'[valor], DESC ) RETURN MAXX ( _top, 'gold participacao_estadual'[nome_municipio] ) & " lidera o PIB nominal" & IF ( ISBLANK ( _r ), "", " da região de " & [Região selecionada (nome)] ) & " de " & _a & ", com " & FORMAT ( MAXX ( _top, 'gold participacao_estadual'[participacao_percentual] ), "0.00" ) & "% do estado"
		displayFolder: 3 Economia
		lineageTag: 523a3dd5-7b79-4de7-bd48-17c916b79be4

	/// ECO2: participação do município no PIB nominal do estado em 2010.
	measure 'ECO2 Participação 2010' = IF ( [Município no recorte] = 1, CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = 2010 ) )
		formatString: 0.0000"%"
		displayFolder: 3 Economia
		lineageTag: 44d57673-4460-4123-9241-9bd484859d22

	/// ECO2: participação do município no PIB nominal do estado no ano do filtro.
	measure 'ECO2 Participação no ano' = [ECO1 Participação no estado (%)]
		formatString: 0.0000"%"
		displayFolder: 3 Economia
		lineageTag: a07c5239-7c2d-43ba-9a71-9bf99d6ff4fe

	/// ECO2: participação no ano menos participação em 2010, em pontos percentuais; em branco se faltar um dos dois.
	measure 'ECO2 Diferença (p.p.)' = VAR _ini = [ECO2 Participação 2010] VAR _fim = [ECO2 Participação no ano] RETURN IF ( NOT ISBLANK ( _ini ) && NOT ISBLANK ( _fim ), _fim - _ini )
		formatString: +0.00" p.p.";−0.00" p.p.";0.00" p.p."
		displayFolder: 3 Economia
		lineageTag: 903904c0-ab98-4230-8030-f128e4c7df06

	/// ECO2: mensagem quando o ano do filtro é 2010.
	measure 'ECO2 Aviso ano 2010' = IF ( [Ano selecionado] = 2010, "Escolha um ano depois de 2010 para comparar com 2010.", "" )
		displayFolder: 3 Economia
		lineageTag: d49d0fdb-30a6-4e29-a219-d93eb4028d4f

	/// ECO2: título (textos.titulo_ganhos_participacao), sobre os 10 maiores do ano dentro da região.
	measure 'ECO2 Título' = VAR _a = [Ano selecionado] VAR _r = [Região selecionada (código)] VAR _t = TOPN ( 10, CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a, NOT ISBLANK ( 'gold participacao_estadual'[valor] ) ), 'gold participacao_estadual'[valor], DESC ) VAR _d = ADDCOLUMNS ( _t, "@ini", VAR _c = 'gold participacao_estadual'[cod_municipio] RETURN CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[cod_municipio] = _c, 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = 2010 ) ) VAR _d2 = ADDCOLUMNS ( FILTER ( _d, NOT ISBLANK ( [@ini] ) ), "@dif", 'gold participacao_estadual'[participacao_percentual] - [@ini] ) VAR _maior = TOPN ( 1, _d2, [@dif], DESC ) RETURN IF ( _a <> 2010, "Dos " & COUNTROWS ( _t ) & " maiores municípios em PIB nominal de " & _a & ", " & COUNTROWS ( FILTER ( _d2, [@dif] > 0 ) ) + 0 & " ganharam participação no estado desde 2010; maior variação: " & MAXX ( _maior, 'gold participacao_estadual'[nome_municipio] ) & " (" & FORMAT ( MAXX ( _maior, [@dif] ), "+0.00;−0.00" ) & " p.p.)" )
		displayFolder: 3 Economia
		lineageTag: f191312d-9f36-4f9b-9f2f-2f4d3d64170e

	/// ECO3: PIB per capita publicado do município da linha no ano do filtro, sem agregação (no total fica em branco). Não é renda (regra 4).
	measure 'ECO3 PIB per capita no ano' = VAR _a = [Ano selecionado] RETURN IF ( [Município no recorte] = 1, CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), 'gold painel_municipio_ano'[ano] = _a ) )
		formatString: "R$" #,0.00
		displayFolder: 3 Economia
		lineageTag: 1a1899f1-8c5b-4207-b549-39f315edd95d

	/// ECO3: mediana entre os municípios (da região, se escolhida) do PIB per capita publicado no ano. Única estatística permitida sobre o per capita; nunca é o per capita do estado ou da região (regra 4, proibição 1).
	measure 'ECO3 PIB per capita: mediana entre os municípios' = VAR _a = [Ano selecionado] VAR _r = [Região selecionada (código)] RETURN CALCULATE ( MEDIAN ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold dim_municipio' ), REMOVEFILTERS ( 'gold painel_municipio_ano'[ano] ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold painel_municipio_ano'[ano] = _a )
		formatString: "R$" #,0.00
		displayFolder: 3 Economia
		lineageTag: 6a0ba410-0d9c-48fc-a3dd-558eed52cc36

	/// ECO3: rótulo obrigatório 'mediana entre os municípios' (textos.rotulo_mediana).
	measure 'ECO3 Rótulo da mediana' = VAR _n = [Região selecionada (nome)] RETURN IF ( ISBLANK ( _n ), "mediana entre os municípios", "mediana entre os municípios da região de " & _n )
		displayFolder: 3 Economia
		lineageTag: 50faa7bb-2247-4e25-95b1-b54d7222d189

	/// ECO3: municípios da região com PIB per capita publicado no ano (base da mediana; contagem).
	measure 'ECO3 Municípios com valor' = VAR _a = [Ano selecionado] VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNT ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold dim_municipio' ), REMOVEFILTERS ( 'gold painel_municipio_ano'[ano] ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold painel_municipio_ano'[ano] = _a ) + 0
		formatString: #,0
		displayFolder: 3 Economia
		lineageTag: 61b10ccd-3573-42a0-a508-5ea4cd0be09a

	/// ECO3: 'maior' se está entre os 10 maiores, 'menor' se está entre os 10 menores da região no ano; em branco nos demais (filtro de visual: não em branco).
	measure 'ECO3 Grupo (10 maiores ou 10 menores)' = VAR _a = [Ano selecionado] VAR _r = [Região selecionada (código)] VAR _v = [ECO3 PIB per capita no ano] VAR _u = CALCULATETABLE ( 'gold painel_municipio_ano', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold painel_municipio_ano'[ano] = _a, NOT ISBLANK ( 'gold painel_municipio_ano'[pib_per_capita_reais] ) ) VAR _acima = COUNTROWS ( FILTER ( _u, 'gold painel_municipio_ano'[pib_per_capita_reais] > _v ) ) + 0 VAR _abaixo = COUNTROWS ( FILTER ( _u, 'gold painel_municipio_ano'[pib_per_capita_reais] < _v ) ) + 0 RETURN IF ( NOT ISBLANK ( _v ), IF ( _acima < 10, "maior", IF ( _abaixo < 10, "menor" ) ) )
		displayFolder: 3 Economia
		lineageTag: b93f4cd6-19eb-4e54-9cd7-29394dd8827a

	/// ECO3: laranja no município escolhido, azul nos 10 maiores, cinza nos 10 menores (como no Streamlit).
	measure 'ECO3 Cor' = IF ( SELECTEDVALUE ( 'gold dim_municipio'[cod_municipio] ) = [Município selecionado (código)], "#eb6834", IF ( [ECO3 Grupo (10 maiores ou 10 menores)] = "maior", "#2a78d6", "#a3a29d" ) )
		displayFolder: 3 Economia
		lineageTag: e090128a-d368-44c1-adc3-34bca7d474e4

	/// ECO3: título (textos.titulo_per_capita). A razão é entre dois valores municipais publicados, não um per capita novo.
	measure 'ECO3 Título' = VAR _a = [Ano selecionado] VAR _r = [Região selecionada (código)] VAR _u = CALCULATETABLE ( 'gold painel_municipio_ano', REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold painel_municipio_ano'[ano] = _a, NOT ISBLANK ( 'gold painel_municipio_ano'[pib_per_capita_reais] ) ) VAR _max = TOPN ( 1, _u, 'gold painel_municipio_ano'[pib_per_capita_reais], DESC ) VAR _min = TOPN ( 1, _u, 'gold painel_municipio_ano'[pib_per_capita_reais], ASC ) VAR _vmax = MAXX ( _max, 'gold painel_municipio_ano'[pib_per_capita_reais] ) VAR _vmin = MAXX ( _min, 'gold painel_municipio_ano'[pib_per_capita_reais] ) RETURN "Em " & _a & ", o PIB per capita de " & MAXX ( _max, 'gold painel_municipio_ano'[nome_municipio] ) & " (R$ " & FORMAT ( _vmax, "#,0" ) & ") é " & FORMAT ( DIVIDE ( _vmax, _vmin ), "0.0" ) & " vezes o de " & MAXX ( _min, 'gold painel_municipio_ano'[nome_municipio] ) & " (R$ " & FORMAT ( _vmin, "#,0" ) & ")"
		displayFolder: 3 Economia
		lineageTag: a421152a-faa7-4c59-93d5-9757af59c46f

	/// ECO4: variações anuais do PIB nominal com |variação| > 50% na região (alerta A1; contagem).
	measure 'ECO4 Variações acima de 50% em módulo' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold variacao_anual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) && ABS ( 'gold variacao_anual'[variacao_percentual] ) > 50 ) + 0
		formatString: #,0
		displayFolder: 3 Economia
		lineageTag: a75d70cb-82fe-4e61-b755-db23aea9aa0a

	/// ECO4: municípios da região com ao menos um salto anual do PIB nominal acima de 50% (contagem).
	measure 'ECO4 Municípios com saltos' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( DISTINCTCOUNT ( 'gold variacao_anual'[cod_municipio] ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold variacao_anual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) && ABS ( 'gold variacao_anual'[variacao_percentual] ) > 50 ) + 0
		formatString: #,0
		displayFolder: 3 Economia
		lineageTag: 461d7e08-8f3b-4db8-9f18-9770a6ad9cf5

	/// ECO4: 1 se a linha da tabela (gold variacao_anual) é PIB nominal com |variação| > 50% e o município está na região (filtro de visual = 1).
	measure 'ECO4 Salto na linha' = VAR _r = [Região selecionada (código)] VAR _cod = SELECTEDVALUE ( 'gold variacao_anual'[cod_municipio] ) VAR _v = SELECTEDVALUE ( 'gold variacao_anual'[variacao_percentual] ) VAR _reg = LOOKUPVALUE ( 'gold dim_municipio'[cod_regiao_intermediaria], 'gold dim_municipio'[cod_municipio], _cod ) RETURN IF ( SELECTEDVALUE ( 'gold variacao_anual'[codigo_indicador] ) = "pib_corrente" && NOT ISBLANK ( _v ) && ABS ( _v ) > 50 && ( ISBLANK ( _r ) || _reg = _r ), 1 )
		formatString: 0
		displayFolder: 3 Economia
		lineageTag: fc1ec1b1-a01a-4909-8269-a02b53c49d1b

	/// ECO4: |variacao_percentual| da linha, para ordenar a tabela pelo módulo.
	measure 'ECO4 Módulo da variação' = VAR _v = SELECTEDVALUE ( 'gold variacao_anual'[variacao_percentual] ) RETURN IF ( NOT ISBLANK ( _v ), ABS ( _v ) )
		formatString: 0.00
		displayFolder: 3 Economia
		lineageTag: 5eb795e0-7a42-4ad2-a215-9f1440b5768b

	/// ECO4: '◀' na linha do município escolhido.
	measure 'ECO4 Destaque' = IF ( SELECTEDVALUE ( 'gold variacao_anual'[cod_municipio] ) = [Município selecionado (código)], "◀" )
		displayFolder: 3 Economia
		lineageTag: 4658f707-5948-4dcb-8521-55961d6a6f9d

	/// ECO4: título (textos.titulo_saltos).
	measure 'ECO4 Título' = [ECO4 Variações acima de 50% em módulo] & " variações anuais do PIB nominal passaram de 50% em módulo, em " & [ECO4 Municípios com saltos] & " municípios"
		displayFolder: 3 Economia
		lineageTag: 95576843-ee32-43f3-8e68-ce525b62e3f0

	/// PER: 'Perfil: Município'.
	measure 'PER Título da página' = "Perfil: " & [Município selecionado (nome)]
		displayFolder: 4 Perfil
		lineageTag: 8e9f3eaf-9cd3-4ba2-8e25-43cbd0938122

	/// PER: código IBGE e regiões intermediária e imediata do município escolhido.
	measure 'PER Identificação' = VAR _m = [Município selecionado (código)] RETURN IF ( NOT ISBLANK ( _m ), "Código IBGE " & _m & " · região intermediária de " & LOOKUPVALUE ( 'gold dim_municipio'[nome_regiao_intermediaria], 'gold dim_municipio'[cod_municipio], _m ) & " · região imediata de " & LOOKUPVALUE ( 'gold dim_municipio'[nome_regiao_imediata], 'gold dim_municipio'[cod_municipio], _m ), "" )
		displayFolder: 4 Perfil
		lineageTag: d7b03625-20ac-4e4c-804b-babfa7145660

	/// PER1: para 4212650 e 4220000, aviso de município instalado depois de 2010 (regras 6 e 10). Ano lido de dim_municipio.
	measure 'PER Aviso instalação' = VAR _inst = LOOKUPVALUE ( 'gold dim_municipio'[ano_instalacao], 'gold dim_municipio'[cod_municipio], [Município selecionado (código)] ) RETURN IF ( NOT ISBLANK ( _inst ), "Município instalado em " & _inst & ": sem dado antes disso (regras 6 e 10).", "" )
		displayFolder: 4 Perfil
		lineageTag: fadd66d8-cf46-497a-9ffb-b04d9cfe4b15

	/// PER1: Censo 2010 do município escolhido (variacao_populacao_censo); em branco se não instalado.
	measure 'PER1 População (Censo 2010)' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[pop_censo_2010] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = _m )
		formatString: #,0
		displayFolder: 4 Perfil
		lineageTag: d89a9507-4152-4862-b62a-58f806b6e603

	/// PER1: Censo 2022 do município escolhido.
	measure 'PER1 População (Censo 2022)' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[pop_censo_2022] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = _m )
		formatString: #,0
		displayFolder: 4 Perfil
		lineageTag: f77fd82c-bc27-42b9-a18c-b24cebdc308f

	/// PER1: variação percentual entre os Censos 2010 e 2022 do município escolhido; em branco com motivo (PER1 Motivo).
	measure 'PER1 Variação entre os Censos' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[variacao_percentual] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = _m )
		formatString: +0.00"%";−0.00"%";0.00"%"
		displayFolder: 4 Perfil
		lineageTag: 38c65173-0b00-4ce0-b0f4-1f35846c3c86

	/// PER1: motivo da view quando não há variação entre os Censos.
	measure 'PER1 Motivo' = VAR _m = [Município selecionado (código)] VAR _mot = CALCULATE ( SELECTEDVALUE ( 'gold variacao_populacao_censo'[motivo] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_populacao_censo'[cod_municipio] = _m ) RETURN IF ( NOT ISBLANK ( _mot ), "Variação entre os Censos: " & _mot & ".", "" )
		displayFolder: 4 Perfil
		lineageTag: 2c214024-852f-4712-94fc-b45b5957ccd3

	/// PER1: PIB nominal (valores correntes) do município escolhido no ano do filtro (regra 3).
	measure 'PER1 PIB nominal no ano' = VAR _m = [Município selecionado (código)] VAR _a = [Ano selecionado] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pib_corrente_reais] ), REMOVEFILTERS ( 'gold painel_municipio_ano' ), 'gold painel_municipio_ano'[cod_municipio] = _m, 'gold painel_municipio_ano'[ano] = _a )
		formatString: "R$" #,0.00
		displayFolder: 4 Perfil
		lineageTag: 61e8b9ae-e229-4312-806c-57ccc00a365b

	/// PER1: PIB per capita publicado do município escolhido no ano; não é renda (regra 4).
	measure 'PER1 PIB per capita no ano' = VAR _m = [Município selecionado (código)] VAR _a = [Ano selecionado] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold painel_municipio_ano' ), 'gold painel_municipio_ano'[cod_municipio] = _m, 'gold painel_municipio_ano'[ano] = _a )
		formatString: "R$" #,0.00
		displayFolder: 4 Perfil
		lineageTag: fdf470f7-2e69-49a2-86ef-7d1c27d3b595

	/// PER1: posição no ranking de pib_corrente do ano (ordem de valor em participacao_estadual), 'Nº de N' ou 'sem dado'.
	measure 'PER1 Posição no PIB nominal' = VAR _a = [Ano selecionado] VAR _m = [Município selecionado (código)] VAR _v = CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[valor] ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[cod_municipio] = _m, 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a ) VAR _n = CALCULATE ( COUNT ( 'gold participacao_estadual'[valor] ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a ) VAR _acima = CALCULATE ( COUNTROWS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", 'gold participacao_estadual'[ano] = _a, 'gold participacao_estadual'[valor] > _v ) + 0 RETURN IF ( ISBLANK ( _v ), "sem dado", ( _acima + 1 ) & "º de " & _n )
		displayFolder: 4 Perfil
		lineageTag: b83822e3-d2dd-4daf-a856-040776b0a208

	/// PER1: posição no ranking de pop_censo 2022 (participacao_estadual), 'Nº de N' ou 'sem dado'.
	measure 'PER1 Posição em população (Censo 2022)' = VAR _m = [Município selecionado (código)] VAR _v = CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[valor] ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[cod_municipio] = _m, 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = 2022 ) VAR _n = CALCULATE ( COUNT ( 'gold participacao_estadual'[valor] ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = 2022 ) VAR _acima = CALCULATE ( COUNTROWS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold participacao_estadual' ), 'gold participacao_estadual'[codigo_indicador] = "pop_censo", 'gold participacao_estadual'[ano] = 2022, 'gold participacao_estadual'[valor] > _v ) + 0 RETURN IF ( ISBLANK ( _v ), "sem dado", ( _acima + 1 ) & "º de " & _n )
		displayFolder: 4 Perfil
		lineageTag: 4f4bb1b2-7a5d-4841-8175-aeacc2430306

	/// PER1: legenda com o PIB nominal exato do ano.
	measure 'PER1 Valor exato do PIB (texto)' = VAR _v = [PER1 PIB nominal no ano] RETURN "PIB nominal " & [Ano selecionado] & ", valor exato: " & IF ( ISBLANK ( _v ), "sem dado", "R$ " & FORMAT ( _v, "#,0.00" ) ) & "."
		displayFolder: 4 Perfil
		lineageTag: f88fbbf5-690e-4c9a-a5e9-5dcee516f76d

	/// PER2: PIB nominal do município escolhido por ano (eixo 'gold painel_municipio_ano'[ano]); em branco antes da instalação (regra 3, regra 5).
	measure 'PER2 PIB nominal (valores correntes)' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pib_corrente_reais] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m )
		formatString: "R$" #,0.00
		displayFolder: 4 Perfil
		lineageTag: c8b92f58-c601-454e-acd3-96b6cfa69d14

	/// PER2: variacao_percentual de variacao_anual (pib_corrente) no ano da linha; variação nominal, não crescimento real (regra 3).
	measure 'PER2 Variação nominal sobre o ano anterior' = VAR _m = [Município selecionado (código)] VAR _y = SELECTEDVALUE ( 'gold painel_municipio_ano'[ano] ) RETURN CALCULATE ( SELECTEDVALUE ( 'gold variacao_anual'[variacao_percentual] ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[cod_municipio] = _m, 'gold variacao_anual'[codigo_indicador] = "pib_corrente", 'gold variacao_anual'[ano] = _y )
		formatString: +0.00"%";−0.00"%";0.00"%"
		displayFolder: 4 Perfil
		lineageTag: 5c38ede1-c473-4ac9-86f0-14f74a4dbeb3

	/// PER2 e PER4: laranja no ano do filtro, azul nos demais.
	measure 'PER Cor do ano (painel)' = IF ( SELECTEDVALUE ( 'gold painel_municipio_ano'[ano] ) = [Ano selecionado], "#eb6834", "#2a78d6" )
		displayFolder: 4 Perfil
		lineageTag: fa6f9f27-2dc9-4355-873f-ecac6066c56c

	/// PER2: lista das variações anuais do PIB nominal acima de 50% em módulo, com o alerta A1; em branco se não houver.
	measure 'PER2 Saltos acima de 50% (texto)' = VAR _m = [Município selecionado (código)] VAR _t = CALCULATETABLE ( 'gold variacao_anual', REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[cod_municipio] = _m, 'gold variacao_anual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) && ABS ( 'gold variacao_anual'[variacao_percentual] ) > 50 ) RETURN IF ( NOT ISEMPTY ( _t ), "Variações acima de 50% em módulo: " & CONCATENATEX ( _t, 'gold variacao_anual'[ano_anterior] & "→" & 'gold variacao_anual'[ano] & " (" & FORMAT ( 'gold variacao_anual'[variacao_percentual], "+0.0;−0.0" ) & "%)", ", ", ABS ( 'gold variacao_anual'[variacao_percentual] ), DESC ) & ". " & [Aviso A1], "" )
		displayFolder: 4 Perfil
		lineageTag: b18a19c3-f3e7-4f03-87a0-93fe1d3a72b8

	/// PER2: título (textos.titulo_serie_pib) com o primeiro e o último ano com valor.
	measure 'PER2 Título' = VAR _m = [Município selecionado (código)] VAR _t = CALCULATETABLE ( 'gold painel_municipio_ano', REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, NOT ISBLANK ( 'gold painel_municipio_ano'[pib_corrente_reais] ) ) VAR _ini = TOPN ( 1, _t, 'gold painel_municipio_ano'[ano], ASC ) VAR _fim = TOPN ( 1, _t, 'gold painel_municipio_ano'[ano], DESC ) VAR _vi = MAXX ( _ini, 'gold painel_municipio_ano'[pib_corrente_reais] ) VAR _vf = MAXX ( _fim, 'gold painel_municipio_ano'[pib_corrente_reais] ) RETURN "PIB nominal de " & [Município selecionado (nome)] & ": de R$ " & IF ( _vi >= 1000000000, FORMAT ( _vi, "0,,,.0" ) & " bi", IF ( _vi >= 1000000, FORMAT ( _vi, "0,,.0" ) & " mi", FORMAT ( _vi, "#,0" ) ) ) & " (" & MAXX ( _ini, 'gold painel_municipio_ano'[ano] ) & ") para R$ " & IF ( _vf >= 1000000000, FORMAT ( _vf, "0,,,.0" ) & " bi", IF ( _vf >= 1000000, FORMAT ( _vf, "0,,.0" ) & " mi", FORMAT ( _vf, "#,0" ) ) ) & " (" & MAXX ( _fim, 'gold painel_municipio_ano'[ano] ) & "), em valores correntes"
		displayFolder: 4 Perfil
		lineageTag: 39ac08e3-d4c9-4a19-a307-767b7d620439

	/// PER3a: pop_estimada do município escolhido, só nos anos da base ate_2012 (eixo 'gold painel_municipio_ano'[ano]; C8, regra 12).
	measure 'PER3a Estimativa – Base até 2012' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pop_estimada] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, 'gold painel_municipio_ano'[base_estimativa] = "ate_2012" )
		formatString: #,0
		displayFolder: 4 Perfil
		lineageTag: 9ebd7b2a-1a12-428e-81a5-99392e1f749c

	/// PER3a: pop_estimada do município escolhido, só nos anos da base 2013_2017 (C8, regra 12).
	measure 'PER3a Estimativa – Base 2013–2017 (nova projeção)' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pop_estimada] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, 'gold painel_municipio_ano'[base_estimativa] = "2013_2017" )
		formatString: #,0
		displayFolder: 4 Perfil
		lineageTag: 369fd148-83fa-4b52-9519-27205e97f420

	/// PER3a: pop_estimada do município escolhido, só nos anos da base desde_2018 (C8, regra 12).
	measure 'PER3a Estimativa – Base desde 2018 (revisão)' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pop_estimada] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, 'gold painel_municipio_ano'[base_estimativa] = "desde_2018" )
		formatString: #,0
		displayFolder: 4 Perfil
		lineageTag: 77d69638-4dab-40a4-bc06-88e86cf8d3ed

	/// PER3b: pop_censo do município escolhido (só 2010 e 2022 têm valor); gráfico separado da estimativa (regra 2).
	measure 'PER3b População (Censo)' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pop_censo] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m )
		formatString: #,0
		displayFolder: 4 Perfil
		lineageTag: bbe5881f-c6ef-47d5-90ea-d6a64c6efd1e

	/// PER3: motivo da view para a variação 2012→2013 do município (quebra de série; regra 12).
	measure 'PER3 Motivo 2012→2013' = VAR _m = [Município selecionado (código)] VAR _mot = CALCULATE ( SELECTEDVALUE ( 'gold variacao_anual'[motivo] ), REMOVEFILTERS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold variacao_anual'[cod_municipio] = _m, 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013 ) RETURN IF ( NOT ISBLANK ( _mot ), "Variação 2012→2013: " & _mot & ".", "" )
		displayFolder: 4 Perfil
		lineageTag: 6fafa846-7a35-419b-8bb2-eb2387b33ecf

	/// PER3: aviso da view (painel_municipio_ano) nos 2 municípios novos, com o aviso da regra 13.
	measure 'PER3 Aviso 2012' = VAR _m = [Município selecionado (código)] VAR _t = CALCULATETABLE ( VALUES ( 'gold painel_municipio_ano'[aviso] ), REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, NOT ISBLANK ( 'gold painel_municipio_ano'[aviso] ) ) RETURN IF ( NOT ISEMPTY ( _t ), "2012: " & CONCATENATEX ( _t, 'gold painel_municipio_ano'[aviso], "; " ) & ". " & [Aviso dupla contagem 2012], "" )
		displayFolder: 4 Perfil
		lineageTag: 71de6301-8448-41fa-9fbf-6ae4db9333ec

	/// PER3a: título da estimativa, sem variação entre bases (textos.titulo_estimativa).
	measure 'PER3a Título' = VAR _m = [Município selecionado (código)] VAR _t = CALCULATETABLE ( 'gold painel_municipio_ano', REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, NOT ISBLANK ( 'gold painel_municipio_ano'[pop_estimada] ) ) VAR _ini = TOPN ( 1, _t, 'gold painel_municipio_ano'[ano], ASC ) VAR _fim = TOPN ( 1, _t, 'gold painel_municipio_ano'[ano], DESC ) VAR _vi = MAXX ( _ini, 'gold painel_municipio_ano'[pop_estimada] ) VAR _vf = MAXX ( _fim, 'gold painel_municipio_ano'[pop_estimada] ) RETURN "Estimativa de população de " & [Município selecionado (nome)] & ": " & IF ( _vi >= 1000000, FORMAT ( _vi, "0,,.00" ) & " mi", IF ( _vi >= 1000, FORMAT ( _vi, "0,.0" ) & " mil", FORMAT ( _vi, "#,0" ) ) ) & " em " & MAXX ( _ini, 'gold painel_municipio_ano'[ano] ) & " e " & IF ( _vf >= 1000000, FORMAT ( _vf, "0,,.00" ) & " mi", IF ( _vf >= 1000, FORMAT ( _vf, "0,.0" ) & " mil", FORMAT ( _vf, "#,0" ) ) ) & " em " & MAXX ( _fim, 'gold painel_municipio_ano'[ano] ) & ", em três bases"
		displayFolder: 4 Perfil
		lineageTag: d075368f-f8b9-4ddd-a01c-42699a59dede

	/// PER3b: título do Censo (textos.titulo_censos); 'sem dado' quando ausente (regra 5).
	measure 'PER3b Título' = VAR _c10 = [PER1 População (Censo 2010)] VAR _c22 = [PER1 População (Censo 2022)] RETURN "Censo de " & [Município selecionado (nome)] & ": " & IF ( ISBLANK ( _c10 ), "sem dado", FORMAT ( _c10, "#,0" ) ) & " pessoas em 2010 e " & IF ( ISBLANK ( _c22 ), "sem dado", FORMAT ( _c22, "#,0" ) ) & " em 2022"
		displayFolder: 4 Perfil
		lineageTag: e87e7936-a43f-426e-b0ab-d8116a7db97c

	/// PER4: PIB per capita publicado do município escolhido por ano (eixo 'gold painel_municipio_ano'[ano]); não é renda (regra 4).
	measure 'PER4 PIB per capita' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold painel_municipio_ano'[pib_per_capita_reais] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m )
		formatString: "R$" #,0.00
		displayFolder: 4 Perfil
		lineageTag: ceb2eeb9-bfc6-42dd-b4b3-2e22b3fadd87

	/// PER4: valores publicados no primeiro e no último ano, sem variação (o denominador muda; textos.titulo_per_capita_municipio).
	measure 'PER4 Título' = VAR _m = [Município selecionado (código)] VAR _t = CALCULATETABLE ( 'gold painel_municipio_ano', REMOVEFILTERS ( 'gold painel_municipio_ano' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold painel_municipio_ano'[cod_municipio] = _m, NOT ISBLANK ( 'gold painel_municipio_ano'[pib_per_capita_reais] ) ) VAR _ini = TOPN ( 1, _t, 'gold painel_municipio_ano'[ano], ASC ) VAR _fim = TOPN ( 1, _t, 'gold painel_municipio_ano'[ano], DESC ) RETURN "PIB per capita de " & [Município selecionado (nome)] & ": R$ " & FORMAT ( MAXX ( _ini, 'gold painel_municipio_ano'[pib_per_capita_reais] ), "#,0" ) & " em " & MAXX ( _ini, 'gold painel_municipio_ano'[ano] ) & " e R$ " & FORMAT ( MAXX ( _fim, 'gold painel_municipio_ano'[pib_per_capita_reais] ), "#,0" ) & " em " & MAXX ( _fim, 'gold painel_municipio_ano'[ano] ) & " (valores publicados, correntes)"
		displayFolder: 4 Perfil
		lineageTag: 7ae72c1d-0ebd-4f36-a07c-4029e88bdcc2

	/// PER5: participacao_percentual de pib_corrente do município escolhido por ano (eixo 'gold participacao_estadual'[ano]).
	measure 'PER5 Participação no PIB nominal do estado' = VAR _m = [Município selecionado (código)] RETURN CALCULATE ( SELECTEDVALUE ( 'gold participacao_estadual'[participacao_percentual] ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[cod_municipio] = _m, 'gold participacao_estadual'[codigo_indicador] = "pib_corrente" )
		formatString: 0.0000"%"
		displayFolder: 4 Perfil
		lineageTag: 0b6b6e84-85bc-4d3d-8c02-bb69883a87a4

	/// PER5: laranja no ano do filtro, azul nos demais.
	measure 'PER5 Cor do ano' = IF ( SELECTEDVALUE ( 'gold participacao_estadual'[ano] ) = [Ano selecionado], "#eb6834", "#2a78d6" )
		displayFolder: 4 Perfil
		lineageTag: 6db53501-cbaf-488b-9a72-23e48b0380d5

	/// PER5: título (textos.titulo_participacao), do primeiro ano com valor ao ano do filtro (ou ao último ano com valor).
	measure 'PER5 Título' = VAR _m = [Município selecionado (código)] VAR _a = [Ano selecionado] VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[cod_municipio] = _m, 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold participacao_estadual'[participacao_percentual] ) ) VAR _anoIni = MINX ( _t, 'gold participacao_estadual'[ano] ) VAR _anoFim = IF ( ISEMPTY ( FILTER ( _t, 'gold participacao_estadual'[ano] = _a ) ), MAXX ( _t, 'gold participacao_estadual'[ano] ), _a ) VAR _vi = MAXX ( FILTER ( _t, 'gold participacao_estadual'[ano] = _anoIni ), 'gold participacao_estadual'[participacao_percentual] ) VAR _vf = MAXX ( FILTER ( _t, 'gold participacao_estadual'[ano] = _anoFim ), 'gold participacao_estadual'[participacao_percentual] ) VAR _verbo = IF ( _vf > _vi, "ganhou", IF ( _vf < _vi, "perdeu", "manteve" ) ) RETURN [Município selecionado (nome)] & " " & _verbo & " participação no PIB nominal do estado: " & FORMAT ( _vi, "0.00" ) & "% em " & _anoIni & " e " & FORMAT ( _vf, "0.00" ) & "% em " & _anoFim
		displayFolder: 4 Perfil
		lineageTag: c8b7c607-4f9d-4174-b4fc-8a1b8e653e8c

	/// PER5: aviso quando o ano do filtro não tem participação (o título usa o último ano com valor).
	measure 'PER5 Aviso ano sem valor' = VAR _m = [Município selecionado (código)] VAR _a = [Ano selecionado] VAR _t = CALCULATETABLE ( 'gold participacao_estadual', REMOVEFILTERS ( 'gold participacao_estadual' ), REMOVEFILTERS ( 'gold dim_municipio' ), 'gold participacao_estadual'[cod_municipio] = _m, 'gold participacao_estadual'[codigo_indicador] = "pib_corrente", NOT ISBLANK ( 'gold participacao_estadual'[participacao_percentual] ) ) RETURN IF ( NOT ISEMPTY ( _t ) && ISEMPTY ( FILTER ( _t, 'gold participacao_estadual'[ano] = _a ) ), "Sem participação no PIB em " & _a & "; o título usa o último ano com valor (" & MAXX ( _t, 'gold participacao_estadual'[ano] ) & ").", "" )
		displayFolder: 4 Perfil
		lineageTag: 34c4b4e5-6ae3-44a1-8727-b18188457105

	/// POP2: ganho em azul, perda em laranja, ausente em cinza e o município escolhido em verde (figuras.cores_por_sinal e barras_divergentes do Streamlit). Compara o código, nunca o nome (regra 1).
	measure 'POP2 Cor por sinal' = VAR _cod = SELECTEDVALUE ( 'gold dim_municipio'[cod_municipio] ) VAR _v = [POP2 Variação percentual] RETURN IF ( NOT ISBLANK ( _cod ) && _cod = [Município selecionado (código)], "#1baf7a", IF ( ISBLANK ( _v ), "#a3a29d", IF ( _v < 0, "#eb6834", "#2a78d6" ) ) )
		displayFolder: 2 População
		lineageTag: d7628662-4806-48c7-bf6c-6da430f5f1a5

	/// ECO4: variação percentual do PIB nominal da linha (gold variacao_anual), para exibir e ordenar a tabela. Em medida, mantém a linha visível (o Power BI esconde linhas sem nenhuma medida preenchida).
	measure 'ECO4 Variação nominal' = SELECTEDVALUE ( 'gold variacao_anual'[variacao_percentual] )
		formatString: +0.00"%";−0.00"%";0.00"%"
		displayFolder: 3 Economia
		lineageTag: adf198bc-d533-49a4-b3d9-ee4d752d364d

	/// Exibição em texto de [VG1a População (Censo 2022)] para cartão: 'sem dado' quando ausente (C4, regra 5), valor exato como no Streamlit.
	measure 'VG1a População (Censo 2022) (exibição)' = VAR _v = [VG1a População (Censo 2022)] RETURN IF ( ISBLANK ( _v ), "sem dado", FORMAT ( _v, "#,0" ) )
		displayFolder: 1 Visão geral
		lineageTag: 0cc64180-1ea6-4a30-b71e-19fe378756ff

	/// Exibição em texto de [VG1b PIB nominal no ano] para cartão: 'sem dado' quando ausente (C4, regra 5), valor exato como no Streamlit.
	measure 'VG1b PIB nominal no ano (exibição)' = VAR _v = [VG1b PIB nominal no ano] RETURN IF ( ISBLANK ( _v ), "sem dado", IF ( _v >= 1000000000, "R$ " & FORMAT ( _v, "0,,,.0" ) & " bi", IF ( _v >= 1000000, "R$ " & FORMAT ( _v, "0,,.0" ) & " mi", "R$ " & FORMAT ( _v, "#,0" ) ) ) )
		displayFolder: 1 Visão geral
		lineageTag: 9014d92a-3b5c-4315-8152-72a25e10d892

	/// Exibição em texto de [VG1c Municípios] para cartão: 'sem dado' quando ausente (C4, regra 5), valor exato como no Streamlit.
	measure 'VG1c Municípios (exibição)' = VAR _v = [VG1c Municípios] RETURN IF ( ISBLANK ( _v ), "sem dado", FORMAT ( _v, "#,0" ) )
