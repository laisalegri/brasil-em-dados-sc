	measure 'POP4 Com variação 2012→2013' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013, NOT ISBLANK ( 'gold variacao_anual'[variacao_percentual] ) ) + 0
