	/// POP4: título sem variação, porque as bases não se comparam (textos.titulo_estimativa).
	measure 'POP4 Título' = VAR _r = [Região selecionada (código)] VAR _t = CALCULATETABLE ( 'gold agregado_regiao_ano', REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", NOT ISBLANK ( 'gold agregado_regiao_ano'[valor] ) ) VAR _ini = TOPN ( 1, _t, 'gold agregado_regiao_ano'[ano], ASC ) VAR _fim = TOPN ( 1, _t, 'gold agregado_regiao_ano'[ano], DESC ) VAR _vi = MAXX ( _ini, 'gold agregado_regiao_ano'[valor] ) VAR _vf = MAXX ( _fim, 'gold agregado_regiao_ano'[valor] ) RETURN "Estimativa de população " & [Território (com preposição)] & ": " & IF ( _vi >= 1000000, FORMAT ( _vi, "0,,.00" ) & " mi", FORMAT ( _vi, "0,.0" ) & " mil" ) & " em " & MAXX ( _ini, 'gold agregado_regiao_ano'[ano] ) & " e " & IF ( _vf >= 1000000, FORMAT ( _vf, "0,,.00" ) & " mi", FORMAT ( _vf, "0,.0" ) & " mil" ) & " em " & MAXX ( _fim, 'gold agregado_regiao_ano'[ano] ) & ", em três bases"
		displayFolder: 2 População
		lineageTag: dd542619-8fe1-4a27-8e48-7a5650c7ff78

	/// POP4: pares municipais da região na variação 2012→2013 da estimativa (regra 12).
	measure 'POP4 Pares 2012→2013' = VAR _r = [Região selecionada (código)] RETURN CALCULATE ( COUNTROWS ( 'gold variacao_anual' ), REMOVEFILTERS ( 'gold dim_municipio' ), FILTER ( ALL ( 'gold dim_municipio'[cod_regiao_intermediaria] ), ISBLANK ( _r ) || 'gold dim_municipio'[cod_regiao_intermediaria] = _r ), 'gold variacao_anual'[codigo_indicador] = "pop_estimada", 'gold variacao_anual'[ano] = 2013 ) + 0
