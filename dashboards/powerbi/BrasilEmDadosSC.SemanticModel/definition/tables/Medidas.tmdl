	/// POP4: aviso quando o ano do filtro não tem estimativa publicada (seção 3).
	measure 'POP4 Sem estimativa (texto)' = VAR _a = [Ano selecionado] VAR _anos = CALCULATETABLE ( VALUES ( 'gold agregado_regiao_ano'[ano] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = "estado", 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", NOT ISBLANK ( 'gold agregado_regiao_ano'[valor] ) ) RETURN IF ( NOT ( _a IN _anos ), "Sem estimativa publicada em " & _a & ": a tabela 6579 cobre " & MINX ( _anos, [ano] ) & "–" & MAXX ( _anos, [ano] ) & ". O Censo não é usado no lugar (limitações, seção 4).", "" )
