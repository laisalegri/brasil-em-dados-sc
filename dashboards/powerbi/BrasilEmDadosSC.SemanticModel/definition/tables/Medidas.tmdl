	/// POP4: estimativa do território no ano do filtro; em branco em 2010, 2022 e 2023 (sem estimativa publicada; o Censo não é usado no lugar).
	measure 'POP4 Estimativa no ano selecionado' = VAR _r = [Região selecionada (código)] VAR _a = [Ano selecionado] RETURN CALCULATE ( SELECTEDVALUE ( 'gold agregado_regiao_ano'[valor] ), REMOVEFILTERS ( 'gold agregado_regiao_ano' ), 'gold agregado_regiao_ano'[nivel] = IF ( ISBLANK ( _r ), "estado", "regiao_intermediaria" ), 'gold agregado_regiao_ano'[cod_regiao] = IF ( ISBLANK ( _r ), "42", _r ), 'gold agregado_regiao_ano'[codigo_indicador] = "pop_estimada", 'gold agregado_regiao_ano'[ano] = _a )
