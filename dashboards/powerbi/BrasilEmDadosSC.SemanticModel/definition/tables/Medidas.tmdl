	/// Início: abertura com o número de municípios e os anos da GOLD (app.py).
	measure 'INI Texto de abertura' = "População e PIB dos " & COUNTROWS ( 'gold dim_municipio' ) & " municípios de Santa Catarina, de " & MIN ( 'gold grade_indicador_municipio_ano'[ano] ) & " a " & MAX ( 'gold grade_indicador_municipio_ano'[ano] ) & ", a partir de dados públicos do IBGE."
		displayFolder: 0 Início
		lineageTag: e947a740-d600-46b0-8e34-16589d1c1f5c

	/// Início: pergunta central com os anos da GOLD (app.py).
	measure 'INI Pergunta central' = "Pergunta central: como os municípios de Santa Catarina se diferenciam em população e dimensão econômica, e como esses indicadores evoluíram entre " & MIN ( 'gold grade_indicador_municipio_ano'[ano] ) & " e " & MAX ( 'gold grade_indicador_municipio_ano'[ano] ) & "?"
		displayFolder: 0 Início
		lineageTag: c202cd25-86a1-4dc1-a51c-872979e2e256

	/// SOB1: anos cobertos pela série (mín.–máx.), como em sql/analise/fontes_series.sql.
	measure 'SOB1 Anos' = VAR _i = MIN ( 'gold grade_indicador_municipio_ano'[ano] ) VAR _f = MAX ( 'gold grade_indicador_municipio_ano'[ano] ) RETURN IF ( NOT ISBLANK ( _i ), _i & "–" & _f )
		displayFolder: 5 Sobre
		lineageTag: a4ff8815-76b1-446b-91c0-a53923bb80a3

	/// SOB1: data da última coleta da série (max(data_coleta)).
	measure 'SOB1 Última coleta' = VAR _d = MAX ( 'gold grade_indicador_municipio_ano'[data_coleta] ) RETURN IF ( NOT ISBLANK ( _d ), FORMAT ( _d, "dd/MM/yyyy" ) )
		displayFolder: 5 Sobre
		lineageTag: 58d85ea4-212e-4075-bf62-be5082e7f7a3

	/// SOB2: linhas da grade por indicador e status, como em sql/analise/cobertura.sql (contagem).
	measure 'SOB2 Linhas (município × ano)' = COUNTROWS ( 'gold grade_indicador_municipio_ano' )
		formatString: #,0
		displayFolder: 5 Sobre
		lineageTag: f47ed9d5-394f-463c-803e-971d9ed5ea97

