	column 'Ano Censo'
		formatString: 0
		lineageTag: daee3daa-23aa-4075-87db-a129d1a78b3d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano Censo]

	partition 'Ano Censo' = calculated
