# Ambiente e segredos
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Dados (gerados pelo pipeline; não versionar)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Controle de execução e logs (gerados pelo pipeline; não versionar)
data/controle/
logs/

# Relatórios gerados pelo agente de verificação
reports/*
!reports/.gitkeep

# Power BI: arquivos temporários
dashboards/powerbi/*.pbix.bak
~$*

# Power BI (PBIP): arquivos locais do Desktop. localSettings.json guarda a assinatura das
# credenciais desta máquina; cache.abf é a cópia dos dados importados (gerada pelo refresh).
dashboards/powerbi/**/.pbi/localSettings.json
dashboards/powerbi/**/.pbi/cache.abf

# Claude Code: configurações locais (os subagents em .claude/agents/ SÃO versionados)
.claude/settings.local.json

# Sistema operacional e editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Schemas PBIR baixados por scripts/powerbi/baixar_schemas.py (cópia local dos oficiais)
scripts/powerbi/schemas/
