# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado.

# PostgreSQL: usuário de escrita (pipeline)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=brasil_em_dados
PG_USER=bed_app
PG_PASSWORD=

# PostgreSQL: usuário somente leitura (agentes)
PG_READONLY_USER=bed_readonly
PG_READONLY_PASSWORD=

# Claude Agent SDK (agente de verificação, a partir do D28)
ANTHROPIC_API_KEY=
