# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado.

# PostgreSQL: usuário de escrita (pipeline)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=brasil_em_dados
PG_USER=bed_app
PG_PASSWORD=

# PostgreSQL: usuário somente leitura (agentes)
PG_READONLY_USER=bed_readonly
PG_READONLY_PASSWORD=

# Claude Agent SDK (agente de verificação, D28/D29): autentica pelo login do plano
# Claude Pro (o mesmo do Claude Code), sem chave de API.
# NÃO defina ANTHROPIC_API_KEY: se ela estiver no ambiente, tem prioridade sobre a
# assinatura e a cobrança passa a ser por uso da API. O agente para ao iniciar se a
# encontrar definida.
